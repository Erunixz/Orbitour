# Copy this file to .env and fill in what you have.
# The server starts without any keys. /api/health lists what is missing.

# Browser (Vite exposes VITE_* publicly). Map Tiles API only. Restrict by HTTP referrer.
VITE_GOOGLE_TILES_KEY=

# Server only. Never prefix with VITE_.
# Routes API only, restricted by API.
GOOGLE_ROUTES_KEY=
OPENAI_API_KEY=
# Reasoning-capable model for the Scout.
LLM_MODEL_SCOUT=
# Model for the Critic. Can match the Scout.
LLM_MODEL_CRITIC=
# Cheap model for parsing replan text.
LLM_MODEL_FAST=
# Leave empty to keep trips in memory (lost on restart).
MONGODB_URI=
MONGODB_DB=tripplanner
# Used in the User-Agent for Nominatim and Wikipedia requests.
CONTACT_EMAIL=
PORT=8787

# Cost guards
# Plans and typed changes per day per visitor (IP address). 0 turns the limit off.
DAILY_TRIP_LIMIT=20
# 3D sessions per device per day (client-side guard).
DAILY_TILE_SESSIONS=50
